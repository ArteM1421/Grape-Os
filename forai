 Эффект использования(() => {
 const t1 = window.setTimeout(() => setShowLogo(true), 100);
 timersRef.current.push(t1);

 let elapsed = 0;

 BOOT_STEPS.forEach((bootStep, i) => {
 const startT = window.setTimeout(() => {
 setStep(i);
 }, elapsed);
 timersRef.current.push(startT);

