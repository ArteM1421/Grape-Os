функция parseAIResponse(текст: строка): { сообщение: строка; обратные вызовы: AICallback[] } {
 постоянные обратные вызовы: AICallback[] = [];

 // Извлечь JSON темы
 const themeMatch = text.match(/<THEME_JSON>([\s\S]*?)<\/THEME_JSON>/);
 if (themeMatch) {
 try {
 const themeData = JSON.parse(themeMatch[1].trim());
 callbacks.push({ type: 'theme', data: themeData });
 } catch {
 // игнорировать ошибку синтаксического анализа
 }
 }

 // Извлечь JSON приложения
 const appMatch = text.match(/<APP_JSON>([\s\S]*?)<\/APP_JSON>/);
 if (appMatch) {
 try {
 const appData = JSON.parse(appMatch[1].trim());
 callbacks.push({ type: 'app', data: appData });
 } catch {
 // игнорировать ошибку синтаксического анализа
 }
 }

 // Очистить сообщение: удалить блоки JSON, но сохранить пояснение
 const message = text
 .replace(/<THEME_JSON>[\s\S]*?<\/THEME_JSON>/g, '[Тема создана — см. Настройки]')
 .replace(/<APP_JSON>[\s\S]*?<\/APP_JSON>/g, '[Приложение создано — проверьте на компьютере]')
 .trim();
 return { message, callbacks };
}

async function callAI(messages: ChatMessage[], config: AIConfig): Promise<string> {
 const response = await fetch(config.endpoint, {
 method: 'POST',
 headers: buildHeaders(config),
 body: buildBody(config, SYSTEM_PROMPT, messages),
 });

 if (!response.ok) {
 throw new Error(`AI request failed (${response.status})`);
 }

 const data = await response.json();
 return extractContent(data);
}

